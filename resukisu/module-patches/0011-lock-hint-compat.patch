+#ifdef CONFIG_OPLUS_LOCK_HINT_COMPAT
+/* Caller-local, outermost lock scope only.  No PID selection, nice or IM writes. */
+static atomic64_t lock_hint_accepted = ATOMIC64_INIT(0);
+static atomic64_t lock_hint_released = ATOMIC64_INIT(0);
+static atomic64_t lock_hint_refused = ATOMIC64_INIT(0);
+
+static ssize_t lock_hint_write(struct file *file, const char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	char command[2], comm[TASK_COMM_LEN];
+	bool root = uid_eq(current_uid(), GLOBAL_ROOT_UID);
+
+	get_task_comm(comm, current->group_leader);
+	if (!root && (__kuid_val(current_uid()) != 1000 ||
+			strcmp(comm, "system_server")))
+		return -EPERM;
+	if (count != 1 && count != 2)
+		return -EINVAL;
+	if (copy_from_user(command, buf, count))
+		return -EFAULT;
+	if ((command[0] != '0' && command[0] != '1') ||
+	    (count == 2 && command[1] != '\n'))
+		return -EINVAL;
+	if (command[0] == '1') {
+		if (test_inherit_ux(current, INHERIT_UX_LOCK_HINT))
+			return -EALREADY;
+		set_inherit_ux(current, INHERIT_UX_LOCK_HINT, 0, SA_TYPE_LISTPICK);
+		if (!test_inherit_ux(current, INHERIT_UX_LOCK_HINT)) {
+			atomic64_inc(&lock_hint_refused);
+			return -EAGAIN;
+		}
+		atomic64_inc(&lock_hint_accepted);
+	} else {
+		unset_inherit_ux(current, INHERIT_UX_LOCK_HINT);
+		atomic64_inc(&lock_hint_released);
+	}
+	return count;
+}
+
+static ssize_t lock_hint_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	char status[192];
+	int len = scnprintf(status, sizeof(status),
+		"port8t_lock_hint_v1 accepted=%lld releases=%lld refused=%lld\n",
+		atomic64_read(&lock_hint_accepted), atomic64_read(&lock_hint_released),
+		atomic64_read(&lock_hint_refused));
+	return simple_read_from_buffer(buf, count, ppos, status, len);
+}
+
+static const struct file_operations lock_hint_fops = {
+	.owner = THIS_MODULE,
+	.read = lock_hint_read,
+	.write = lock_hint_write,
+	.llseek = default_llseek,
+};
+#endif
