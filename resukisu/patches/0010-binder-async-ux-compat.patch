+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _BINDER_ASYNC_UX_H
+#define _BINDER_ASYNC_UX_H
+#include <linux/types.h>
+struct task_struct;
+struct binder_buffer;
+#ifdef CONFIG_OPLUS_BINDER_ASYNC_UX_COMPAT
+bool binder_async_ux_requested(void);
+void binder_async_ux_boost(struct binder_buffer *, struct task_struct *);
+void binder_async_ux_release(struct binder_buffer *);
+#else
+static inline bool binder_async_ux_requested(void) { return false; }
+static inline void binder_async_ux_boost(struct binder_buffer *b, struct task_struct *t) {}
+static inline void binder_async_ux_release(struct binder_buffer *b) {}
+#endif
+#endif
