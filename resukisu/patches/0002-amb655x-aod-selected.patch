+			&panel->cur_mode->priv_info->cmd_sets[DSI_CMD_SET_LP1];
+
+		if (dsi_panel_amb655x_skip_display_off(panel, DSI_CMD_SET_LP1,
+				lp1->cmds, lp1->count))
